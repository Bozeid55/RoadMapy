---
title: Roadmapy - Password Reset Activity
---
flowchart LR
    subgraph user["User"]
        direction TB
        start@{ shape: f-circ, label: "" }
        requestReset["Request a password reset using the account email"]
        submitResetToken["Submit the reset token and a new credential"]
    end

    subgraph system["Roadmapy System"]
        direction TB
        findAccount["Look up the account by email without exposing account existence"]
        accountDecision{"Eligible account found?"}
        createToken["Create a password_reset_tokens record using only the token hash"]
        sendReset["Send the reset token through the configured delivery channel"]
        deliveryDecision{"Reset message delivered?"}
        retryDelivery["Retry delivery using the same token; do not create another token"]
        deliveryRetryDecision{"Bounded delivery retry remains?"}
        deliveryUnavailable["Show the same generic response; do not disclose account existence"]
        genericResponse["Show a generic response that does not disclose account existence"]
        genericNoAccount["Show the same generic response; create no token"]
        tokenDecision{"Token hash and configured validity policy pass?"}
        resetRejected["Reject the reset; leave the credential unchanged and require a new token if the valid token was already consumed"]
        updateCredential["Request credential update from the configured authentication mechanism"]
        credentialDecision{"Credential update succeeded?"}
        consumeMerge{"Merge initial and bounded one-time token-consumption attempts"}
        consumeToken["Conditionally delete this still-valid password_reset_tokens row before changing the credential; require exactly one row consumed"]
        consumeDecision{"Exactly one valid reset-token row consumed?"}
        resetSuccess["Confirm password reset"]
        retryConsume["Retry conditional one-time token deletion; do not update credentials until one row is consumed"]
        retryDecision{"Token-consumption retry budget remains?"}
        cleanupPending["Do not change the credential; report that reset could not proceed and require a new token if needed"]
        activityFinal@{ shape: dbl-circ, label: "●" }
    end

    subgraph auth["Configured Authentication Mechanism"]
        direction TB
        applyCredential["Apply the new credential"]
    end

    start --> requestReset --> findAccount --> accountDecision
    accountDecision -->|Yes| createToken --> sendReset --> deliveryDecision
    deliveryDecision -->|Yes| genericResponse --> submitResetToken --> tokenDecision
    deliveryDecision -->|No| retryDelivery --> deliveryRetryDecision
    deliveryRetryDecision -->|Yes| sendReset
    deliveryRetryDecision -->|No| deliveryUnavailable --> activityFinal
    accountDecision -->|No| genericNoAccount --> activityFinal
    tokenDecision -->|Invalid or expired| resetRejected --> activityFinal
    tokenDecision -->|Valid| consumeMerge
    consumeMerge --> consumeToken --> consumeDecision
    consumeDecision -->|Yes| updateCredential --> applyCredential --> credentialDecision
    credentialDecision -->|No| resetRejected
    credentialDecision -->|Yes| resetSuccess --> activityFinal
    consumeDecision -->|No| retryConsume --> retryDecision
    retryDecision -->|Yes| consumeMerge
    retryDecision -->|No| cleanupPending --> activityFinal

    classDef umlInitial fill:#111,stroke:#111,color:#111;
    classDef umlFinal fill:#fff,stroke:#111,stroke-width:3px,color:#111;
    class start umlInitial;
    class activityFinal umlFinal;
